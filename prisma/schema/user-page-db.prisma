model UserPageDb {
    id                  String  @id @default(uuid())
    pageName            String  @unique
    fullName            String
    location            String
    position            String
    description         String?
    personalWebsiteLink String?
    githubLink          String?
    linkedInLink        String?
    mediumLink          String?
    twitterLink         String?
    youtubeLink         String?
    instagramLink       String?

    projects UserProjectDb[]

    userId String @unique
    user   UserDb @relation(fields: [userId], references: [id])
}
