model UserProjectDb {
    id           String  @id @default(uuid())
    name         String
    pictureUrl   String?
    description  String?
    label        String?
    topLink      String?
    bottomLink   String?
    displayOrder Int

    skills ProjectSkillDb[]

    userPage   UserPageDb @relation(fields: [userPageId], references: [id], onDelete: Cascade)
    userPageId String
}
